# ==============================================================================
# AirdropOS - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS. NEVER COMMIT .env!
# ==============================================================================

# Application Environment
# 'production' enforces secure configuration at startup (no default/placeholder secrets,
# AUTH_ENABLED=true, an operator password hash).
ENVIRONMENT=development
LOG_LEVEL=INFO
# REQUIRED in production (the built-in default is public). Generate with: openssl rand -hex 32
# SECRET_KEY=
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL Database
# docker compose requires POSTGRES_PASSWORD (it builds DATABASE_URL for the containers from it).
# Generate with: openssl rand -hex 24
# POSTGRES_PASSWORD=
# For `python run.py` outside Docker, set a DATABASE_URL that uses the same password:
DATABASE_URL=postgresql+asyncpg://airdropos:CHANGE_ME@localhost:5432/airdropos_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# SINGLE FIXED LLM CONFIGURATION (MANDATORY: ONE MODEL ONLY)
# ==============================================================================
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-openai-or-compatible-api-key-here
LLM_MODEL_ID=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ==============================================================================
# AUTONOMOUS SECURITY & SPENDING LIMITS (ENFORCED DETERMINISTICALLY)
# ==============================================================================
EMERGENCY_STOP_ENABLED=false
# Shared state files (API + worker must see the same ./data directory)
EMERGENCY_STOP_STATE_FILE=./data/emergency_stop.json
SPEND_LEDGER_PATH=./data/spend_ledger.db
# Reverse proxies whose X-Forwarded-For the API may believe for rate limiting (comma-separated IPs/CIDRs).
# Empty = trust no forwarded header. Only list your own proxies. See docs/DEPLOYMENT.md section 8.
TRUSTED_PROXIES=
MAX_TRANSACTION_VALUE_USD=50.0
MAX_DAILY_GAS_SPEND_USD=25.0
MAX_CONCURRENT_TASKS=5
MAX_TASK_RETRIES=3
MAX_EXECUTION_LOOP_ITERATIONS=20
REQUIRE_CONFIRMATION_ABOVE_USD=100.0

# Wallet Vault & Key Encryption (AES-256-GCM)
# Exactly 64 hex characters (optionally 0x-prefixed). Generate with: openssl rand -hex 32
# REQUIRED in production: ENVIRONMENT=production refuses to start on the built-in default.
# NEVER change this on a deployment that already holds wallets: stored keys are encrypted with it
# and would become undecryptable. Back it up separately from the database.
# WALLET_VAULT_MASTER_KEY=

# ==============================================================================
# BLOCKCHAIN RPC PROVIDERS (EVM & EXTENSIBLE)
# ==============================================================================
RPC_ETHEREUM_MAINNET=https://eth-mainnet.g.alchemy.com/v2/your-api-key
RPC_ARBITRUM_ONE=https://arb-mainnet.g.alchemy.com/v2/your-api-key
RPC_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/your-api-key
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/your-api-key
RPC_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/your-api-key
RPC_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/your-api-key

# ==============================================================================
# INTEGRATIONS & SOCIAL MONITORS (OPTIONAL IF UNCONFIGURED)
# ==============================================================================
# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_USER_IDS=[]
TELEGRAM_WEBHOOK_URL=

# --- Telegram USER client (agent works through YOUR Telegram account) ---
# 1. Get API_ID / API_HASH at https://my.telegram.org  ->  API development tools
# 2. Run once in a terminal:  python scripts/telegram_login.py
#    (phone, login code and 2FA password are typed there, never in the chat)
# 3. Set TELEGRAM_USER_ENABLED=true and restart backend + worker.
# Use a SEPARATE Telegram account, not your main one: automation can get an
# account limited, and the session file gives full access to the account.
TELEGRAM_USER_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telegram/agent
TELEGRAM_USER_MIN_ACTION_DELAY_SECONDS=3
TELEGRAM_USER_DAILY_ACTION_LIMIT=60

# Discord Monitor (Bot token with Message Content Intent)
DISCORD_BOT_TOKEN=
DISCORD_MONITORED_CHANNELS=[]

# X / Twitter API v2
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ==============================================================================
# BROWSER AUTOMATION (PLAYWRIGHT)
# ==============================================================================
BROWSER_HEADLESS=true
BROWSER_USER_DATA_DIR=./data/browser_sessions
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_ACTION_TIMEOUT_MS=15000
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800
# Browsers refuse loopback/link-local/metadata targets always, private LAN ranges unless true.
# Hostnames are resolved and every address they map to is checked, redirects and page
# sub-requests included. This also covers internal Docker service names (postgres, redis, backend).
# Keep it false unless you really need LAN pages, and prefer an egress firewall on the worker.
BROWSER_ALLOW_PRIVATE_NETWORK=false

# --- Live Broadcast -------------------------------------------------------
# The worker (which owns the browsers) serves an internal gateway that only the
# API talks to. Defaults work for `python run.py`. In Docker the compose file
# binds it to the private network. Never publish this port.
LIVE_GATEWAY_ENABLED=true
LIVE_GATEWAY_HOST=127.0.0.1
LIVE_GATEWAY_PORT=8765
LIVE_GATEWAY_URL=http://127.0.0.1:8765
# Optional. Derived from SECRET_KEY when empty. Required if the gateway is
# reachable beyond loopback and SECRET_KEY is still the default.
LIVE_GATEWAY_SECRET=
# Values are range-checked at startup: lock TTL 10-600 s, human wait 60-86400 s,
# JPEG quality 20-95, browser sessions 1-50.
LIVE_CONTROL_LOCK_TTL_SECONDS=45
LIVE_HUMAN_WAIT_TIMEOUT_SECONDS=1800
# Each running browser session is a Chromium context in the worker; starting more is refused.
LIVE_MAX_BROWSER_SESSIONS=6

# ==============================================================================
# 24/7 SCHEDULER & DISCOVERY SETTINGS
# ==============================================================================
SCHEDULER_HEARTBEAT_SECONDS=30
DISCOVERY_INTERVAL_MINUTES=60
MONITORING_INTERVAL_MINUTES=15
CLAIM_CHECK_INTERVAL_MINUTES=30
DAILY_REPORT_HOUR_UTC=8

# ==============================================================================
# OPERATOR LOGIN (required when AUTH_ENABLED=true, which is the default)
# ==============================================================================
# Generate the hash with:
#   python -c "from backend.app.security.auth import hash_password; print(hash_password('your-password'))"
# Keep the single quotes: the hash contains '$' characters.
OPERATOR_EMAIL=operator@airdropos.local
OPERATOR_PASSWORD_HASH=
